{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Import plan",
  "description": "Input of `bun scripts/import.js <plan.json>`: the Editions to import (or re-fetch) and any new Events they need. Plan files are not committed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["editions"],
  "properties": {
    "events": {
      "type": "array",
      "description": "New Events only. An Event already in race-info.json is referenced by id from editions[].event.",
      "items": { "$ref": "#/definitions/NewEvent" }
    },
    "editions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Edition" }
    }
  },
  "definitions": {
    "Id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "Date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "Distance": {
      "type": "string",
      "enum": [
        "LD",
        "MD",
        "OD",
        "SD",
        "SS",
        "DUATHLON",
        "AQUATHLON",
        "MARATHON",
        "OTHER"
      ]
    },
    "Sport": {
      "type": "string",
      "enum": ["swim", "bike", "run", "trail_running"]
    },
    "TsvFile": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.tsv$" },
    "Segments": {
      "type": "array",
      "description": "Which Segments exist, in course order, with their km. Omit a Segment (e.g. swim) when it was cancelled.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sport", "distance"],
        "properties": {
          "sport": { "$ref": "#/definitions/Sport" },
          "distance": { "type": "number", "minimum": 0 }
        }
      }
    },
    "NewEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "location_parts", "image", "source"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "location_parts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["country"],
          "properties": {
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "prefecture": { "type": "string" },
            "region": { "type": "string" },
            "city": { "type": "string" },
            "venue": { "type": "string" }
          }
        },
        "description": { "type": "string" },
        "image": {
          "type": "string",
          "pattern": "^images/[A-Za-z0-9_.-]+\\.webp$"
        },
        "source": { "type": "string", "pattern": "^https?://" },
        "insert_before": {
          "description": "Id of an existing Event the new Event is inserted before; appended when absent.",
          "$ref": "#/definitions/Id"
        }
      }
    },
    "Ironman": {
      "description": "IRONMAN subevent uuid, or an object with options. The template defaults from the Event's existing Distance classes (LD → full, MD → 70.3).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "template": { "type": "string", "enum": ["full", "70.3"] },
            "description": { "type": "string" },
            "segments": { "$ref": "#/definitions/Segments" }
          }
        }
      ]
    },
    "JtuColumns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rename": {
          "type": "object",
          "description": "Caption → TSV header",
          "additionalProperties": { "type": "string" }
        },
        "drop": {
          "type": "array",
          "description": "Captions to drop (\"\" is the null-caption slug column)",
          "items": { "type": "string" }
        },
        "constants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["header", "value", "after"],
            "properties": {
              "header": { "type": "string" },
              "value": { "type": "string" },
              "after": { "type": "string" }
            }
          }
        }
      }
    },
    "JtuProgram": {
      "type": "object",
      "description": "One JTU program = one Category. id / file / name default from the previous Edition's only Category of the same Distance class.",
      "additionalProperties": false,
      "required": ["program", "distance", "description"],
      "properties": {
        "program": { "type": "string", "pattern": "^[0-9]+_[0-9]+$" },
        "distance": { "$ref": "#/definitions/Distance" },
        "id": { "$ref": "#/definitions/Id" },
        "file": { "$ref": "#/definitions/TsvFile" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "segments": { "$ref": "#/definitions/Segments" },
        "columns": { "$ref": "#/definitions/JtuColumns" }
      }
    },
    "JtuRefetch": {
      "type": "object",
      "description": "Column options for re-fetching one program of the Edition.",
      "additionalProperties": false,
      "required": ["program"],
      "properties": {
        "program": { "type": "string", "pattern": "^[0-9]+_[0-9]+$" },
        "columns": { "$ref": "#/definitions/JtuColumns" }
      }
    },
    "ColumnMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "role"],
      "properties": {
        "header": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "Prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tsv",
        "id",
        "file",
        "name",
        "distance",
        "description",
        "segments",
        "meta_columns"
      ],
      "properties": {
        "tsv": { "type": "string", "description": "Path of the prepared TSV" },
        "id": { "$ref": "#/definitions/Id" },
        "file": { "$ref": "#/definitions/TsvFile" },
        "name": { "type": "string", "minLength": 1 },
        "distance": { "$ref": "#/definitions/Distance" },
        "description": { "type": "string" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sport", "distance", "columns"],
            "properties": {
              "sport": { "$ref": "#/definitions/Sport" },
              "distance": { "type": "number", "minimum": 0 },
              "columns": {
                "type": "array",
                "items": { "$ref": "#/definitions/ColumnMapping" }
              }
            }
          }
        },
        "meta_columns": {
          "type": "array",
          "items": { "$ref": "#/definitions/ColumnMapping" }
        },
        "unmapped": {
          "type": "array",
          "description": "Headers kept in the TSV without a Column role",
          "items": { "type": "string" }
        },
        "source_url": { "type": ["string", "null"] }
      }
    },
    "Edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "date"],
      "properties": {
        "event": { "$ref": "#/definitions/Id" },
        "date": { "$ref": "#/definitions/Date" },
        "mode": {
          "type": "string",
          "enum": ["add", "refetch"],
          "default": "add"
        },
        "ironman": { "$ref": "#/definitions/Ironman" },
        "jtu": { "type": "array", "minItems": 1 },
        "prepared": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Prepared" }
        },
        "weather": {
          "type": "boolean",
          "default": true,
          "description": "Write the weather_file reference (<dir>/weather-data.json). The file itself is generated separately."
        }
      },
      "if": {
        "required": ["mode"],
        "properties": { "mode": { "const": "refetch" } }
      },
      "then": {
        "description": "Refetch re-reads each Category's source_ref; only JTU column options may be given.",
        "not": {
          "anyOf": [
            { "required": ["ironman"] },
            { "required": ["prepared"] },
            { "required": ["weather"] }
          ]
        },
        "properties": {
          "jtu": { "items": { "$ref": "#/definitions/JtuRefetch" } }
        }
      },
      "else": {
        "oneOf": [
          { "required": ["ironman"] },
          { "required": ["jtu"] },
          { "required": ["prepared"] }
        ],
        "properties": {
          "jtu": { "items": { "$ref": "#/definitions/JtuProgram" } }
        }
      }
    }
  }
}
